# New installations: sign in as admin / admin, then change password in the web UI.
# NAS host path (the entire subtree is accessible inside the application).
NAS_PATH=/volume1/data
# Persist queue, settings, encrypted credentials, and secret.key together.
APP_DATA_PATH=./data
# NAS account with read/write permission on both paths. Run id on the NAS.
PUID=1000
PGID=1000
WEB_BIND=0.0.0.0
WEB_PORT=8080
TZ=Asia/Seoul
# true only when accessed through an HTTPS reverse proxy
COOKIE_SECURE=false
